{
  "name": "lucas-academy-video",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Video prototypes for Lucas Academy lessons, starting with Monkey Republic society simulations.",
  "scripts": {
    "data": "node scripts/generate-monkey-data.mjs",
    "intro:assets": "node scripts/build-intro-assets.mjs",
    "intro:voice": "node scripts/render-intro-voice.mjs",
    "intro:render": "remotion render src/index.ts MonkeyIntro out/monkey-intro.mp4",
    "intro:still": "remotion still src/index.ts MonkeyIntro out/monkey-intro.png --frame=720",
    "milestone1:render": "remotion render src/index.ts RollerCoasterMilestone1 out/roller-coaster-milestone-1.mp4",
    "milestone1:still": "remotion still src/index.ts RollerCoasterMilestone1 out/roller-coaster-milestone-1.png --frame=430",
    "milestone2:render": "remotion render src/index.ts RollerCoasterMilestone2 out/roller-coaster-milestone-2.mp4",
    "milestone2:still": "remotion still src/index.ts RollerCoasterMilestone2 out/roller-coaster-milestone-2.png --frame=600",
    "milestones:short": "remotion render src/index.ts RollerCoasterMilestonesShort out/roller-coaster-milestones-1-2-short-vertical.mp4",
    "milestone3:build": "remotion render src/index.ts RollerCoasterMilestone3Build out/roller-coaster-milestone-3-build.mp4",
    "milestone3:build:vertical": "remotion render src/index.ts RollerCoasterMilestone3BuildVertical out/roller-coaster-milestone-3-build-vertical.mp4",
    "roller:render": "npm run milestone1:render",
    "roller:still": "npm run milestone1:still",
    "start": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts MonkeySociety out/monkey-society.mp4",
    "preview": "remotion preview src/index.ts MonkeySociety",
    "song:render": "remotion render src/index.ts OneBreath out/one-breath-v2.mp4",
    "song:still": "remotion still src/index.ts OneBreath out/one-breath-v2.png --frame=7890",
    "song:align": ".venv-align/bin/python scripts/align/align_lyrics.py",
    "rejoice:render": "remotion render src/index.ts Rejoice out/rejoice.mp4",
    "rejoice:preview": "remotion render src/index.ts RejoiceWindow out/rejoice-window.mp4",
    "rejoice:finale": "remotion render src/index.ts RejoiceFinale out/rejoice-finale.mp4",
    "rejoice:shots": ".venv-align/bin/python scripts/mv/build_shots.py"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.484",
    "@remotion/renderer": "^4.0.484",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "remotion": "^4.0.484",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17"
  }
}
