node_modules/
out/
dist/
.DS_Store
.env

# Lyrics-video pipeline artefacts. All of these are regenerated by the scripts in
# scripts/ -- none of them belong in the repo.
.venv*/
tmp/
t2v/.venv/
t2v/models/
t2v/outputs/
public/footage/*
public/footage-esrgan/
# ...but the provenance record is the only trace of where third-party clips came
# from, so it is tracked even though the media beside it is not.
!public/footage/CREDITS.md
public/audio/songs/
stems/

# Voice-cover environments and data. ~10 GB of venvs, model weights and audio --
# rebuild with voice-cover/SETUP.md rather than committing any of it.
rvc/*
!rvc/README.md
svc/*
!svc/README.md

# align_lyrics.py writes these next to the song; they are regenerated, and the
# checked-in one-breath.json is the version that matters.
src/songs/*.aligned.json
src/songs/*.estimated.json

# Python bytecode from the pipeline scripts.
__pycache__/
*.pyc

# Working directories for other threads of work (reframe experiments, staged
# deletions). Large, regenerated, and not part of any song's build.
output/
_review-delete/

# Van Gogh video (media#3): the paintings, the room music and the generated
# narration (cloned voices) stay local. art/SOURCES.txt and music/SOURCE.md
# record where each came from; scripts/vg-why/fetch_assets.py restores the
# pictures and the music, and lucas-academy-media regenerates the narration.
public/vg-why-paint-them/art/*.jpg
public/vg-why-paint-them/art/tiles/
public/vg-why-paint-them/music/*.mp3
public/vg-why-paint-them/audio/

# Language Bridge videos (media#4): the Codex concept images, the product screens
# (they show NIV text) and the generated narration stay local. The prompts are in
# docs/RECIPROCAL-DOORS-IMAGE-PROMPTS.md; scripts/reciprocal-doors-capture-product.mjs
# re-captures the product screens (product/regions.json is tracked: the film points
# at those rects); lucas-academy-media regenerates the narration. The background
# music (public/audio/reciprocal-doors/music/) is fetched with the command in
# LANGUAGE-BRIDGE.md.
public/images/reciprocal-doors/*.png
public/images/reciprocal-doors/product/*.png
public/audio/reciprocal-doors/

# 全人教育的五个理念 (media#5): the timelines, narration tracks, app recordings, transit-chamber
# capture, music bed and the kids' artwork copies are local working copies, rebuilt when needed.
# WHOLE-PERSON-01.md says where each comes from and how to rebuild it.
public/whole-person-01/

# Fun Informatics 1 · 计算机怎么算 1+1=？: room recordings, the self-rendered fractal zoom, Codex circuit
# images, narration, timelines and mixes are local working copies; FUN-INFORMATICS-01.md
# says where each comes from and how to rebuild it.
public/fun-informatics-01/
