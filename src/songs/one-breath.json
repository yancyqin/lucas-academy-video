  "lines": [
    {
      "t": 26.36,
      "section": "verse",
      "text": "You knelt down in the dust and clay"
    },
    {
      "t": 33.08,
      "section": "verse",
      "text": "You breathed and there was breath in me"
    },
    {
      "t": 39.78,
      "section": "verse",
      "text": "and dust became a soul"
    },
    {
      "t": 44.68,
      "section": "verse",
      "text": "One breath, and I was Yours alone"
    },
    {
      "t": 48.18,
      "section": "verse",
      "text": "A life You freely gave"
    },
    {
      "t": 59.76,
      "section": "verse",
      "text": "The grass will wither, flowers fall"
    },
    {
      "t": 66.4,
      "section": "verse",
      "text": "I cannot add a single hour"
    },
    {
      "t": 73.16,
      "section": "verse",
      "text": "and still You clothe the grass"
    },
    {
      "t": 77.76,
      "section": "verse",
      "text": "You feed the birds, You know my name"
    },
    {
      "t": 81.48,
      "section": "verse",
      "text": "The life I treasure still"
    },
    {
      "t": 85.82,
      "section": "prechorus",
      "text": "And yet the dust is not the end"
    },
    {
      "t": 89.52,
      "section": "prechorus",
      "text": "The breath You gave, You give again"
    },
    {
      "t": 92.12,
      "section": "prechorus",
      "text": "The breath we could not hold, You hold"
    },
    {
      "t": 98.78,
      "section": "prechorus",
      "text": "So we rise —"
    },
    {
      "t": 102.26,
      "section": "chorus",
      "text": "I'll be reborn, you'll be reborn"
    },
    {
      "t": 108.96,
      "section": "chorus",
      "text": "You and me — together, one breath"
    },
    {
      "t": 117.46,
      "section": "chorus",
      "text": "Not dust, not grass — this will not fade"
    },
    {
      "t": 124.3,
      "section": "chorus",
      "text": "One breath we will hold forever"
    },
    {
      "t": 136.74,
      "section": "verse",
      "text": "But there's a seed that will not die"
    },
    {
      "t": 143.16,
      "section": "verse",
      "text": "A life I never could have seen"
    },
    {
      "t": 149.8,
      "section": "verse",
      "text": "and yet I hold it sure"
    },
    {
      "t": 154.26,
      "section": "verse",
      "text": "You promised, and the promise stands"
    },
    {
      "t": 158.1,
      "section": "verse",
      "text": "This life is given me"
    },
    {
