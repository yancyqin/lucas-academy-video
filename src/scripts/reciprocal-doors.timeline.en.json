                "offset": 0,
                "seconds": 1.943
              }
            ]
          }
        },
        {
          "id": "rd06-05",
          "zh": "Mary 试着说中文，Jacob 试着说英文。",
          "en": "Mary tries the Chinese, and Jacob tries the English.",
          "start": 149.988,
          "slot": 3.907,
          "spoken": {
            "zh": 4.066,
            "en": 3.907
          },
          "tracks": {
            "en": [
              {
                "id": "rd06-05",
                "file": "audio/reciprocal-doors/en/rd06-05.wav",
                "lang": "en",
                "demo": false,
                "offset": 0,
                "seconds": 3.907
              }
            ]
          }
        },
        {
          "id": "rd06-06",
          "zh": "说不顺，可以听一听，再试一次。",
          "en": "If a phrase is difficult, they can listen and try again.",
          "start": 154.345,
          "slot": 4.848,
          "spoken": {
            "zh": 5.105,
            "en": 4.848
          },
          "tracks": {
            "en": [
              {
                "id": "rd06-06",
                "file": "audio/reciprocal-doors/en/rd06-06.wav",
                "lang": "en",
                "demo": false,
                "offset": 0,
                "seconds": 4.848
              }
            ]
          }
        },
        {
          "id": "rd06-07",
          "zh": "遇到不认识的字，就把这个字找出来，一起学。",
          "en": "If a written word is unfamiliar, they find it and learn it together.",
          "start": 159.643,
          "slot": 4.979,
          "spoken": {
            "zh": 5.88,
            "en": 4.979
          },
          "tracks": {
            "en": [
              {
                "id": "rd06-07",
                "file": "audio/reciprocal-doors/en/rd06-07.wav",
