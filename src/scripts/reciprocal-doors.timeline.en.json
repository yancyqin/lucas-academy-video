                "demo": false,
                "offset": 0,
                "seconds": 4.979
              }
            ]
          }
        },
        {
          "id": "rd06-08",
          "zh": "老师在旁边，帮他们确认意思。",
          "en": "Their teacher helps them check the meaning.",
          "start": 165.222,
          "slot": 2.1,
          "spoken": {
            "zh": 4.08,
            "en": 2.1
          },
          "tracks": {
            "en": [
              {
                "id": "rd06-08",
