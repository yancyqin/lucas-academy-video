                "demo": false,
                "offset": 0,
                "seconds": 6.401
              }
            ]
          }
        },
        {
          "id": "rd06-02",
          "zh": "Jacob 指着画说：“我来帮你。”",
          "en": "Jacob points to the picture and says, “我来帮你.”",
          "start": 137.327,
          "slot": 4.178,
          "spoken": {
            "zh": 3.455,
            "en": 4.178
          },
          "tracks": {
            "en": [
