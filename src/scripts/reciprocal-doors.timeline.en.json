                "seconds": 0.833
              }
            ]
          }
        },
        {
          "id": "rd06-03",
          "zh": "Mary 告诉他，英文可以说：“Let me help you.”",
          "en": "Mary tells him, “In English, we can say, ‘Let me help you.’”",
          "start": 141.955,
          "slot": 5.09,
          "spoken": {
            "zh": 5.361,
            "en": 5.09
          },
          "tracks": {
            "en": [
              {
                "id": "rd06-03-p1",
                "file": "audio/reciprocal-doors/en/rd06-03-p1.wav",
