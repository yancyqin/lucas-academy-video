              }
            ]
          }
        }
      ]
    },
    {
      "id": "rd06",
      "start": 154.481,
      "end": 195.137,
      "chunks": [
        {
          "id": "rd06-01",
          "zh": "比如，他们一起画一个小故事：杯子倒了，朋友来帮忙。",
          "en": "For example, they draw a small story: a cup tips over, and a friend comes to help.",
          "start": 155.181,
          "slot": 6.495,
          "spoken": {
            "zh": 6.495,
            "en": 6.401
          },
          "tracks": {
            "zh": [
              {
                "id": "rd06-01",
                "file": "audio/reciprocal-doors/zh/rd06-01.wav",
                "lang": "zh",
                "demo": false,
                "offset": 0,
                "seconds": 6.495
              }
            ]
          }
        },
        {
          "id": "rd06-02",
          "zh": "Jacob 指着画说：“我来帮你。”",
          "en": "Jacob points to the picture and says, “我来帮你.”",
          "start": 162.126,
          "slot": 3.455,
          "spoken": {
            "zh": 3.455,
            "en": 4.178
          },
          "tracks": {
            "zh": [
