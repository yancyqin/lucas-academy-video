                "offset": 0,
                "seconds": 4.947
              }
            ]
          }
        }
      ]
    },
    {
      "id": "rd06",
      "start": 119.919,
      "end": 151.837,
      "chunks": [
        {
          "id": "rd06-01",
          "zh": "比如，他们一起画一个小故事：杯子倒了，朋友来帮忙。",
          "en": "For example, they draw a small story: a cup tips over, and a friend comes to help.",
          "start": 120.458,
          "slot": 5.004,
          "spoken": {
            "zh": 5.004,
            "en": 6.401
          },
          "tracks": {
            "zh": [
              {
                "id": "rd06-01",
                "file": "audio/reciprocal-doors/zh/rd06-01.wav",
                "lang": "zh",
                "demo": false,
                "offset": 0,
                "seconds": 5.004
              }
            ]
          }
        },
        {
          "id": "rd06-02",
          "zh": "Jacob 指着画说：“我来帮你。”",
          "en": "Jacob points to the picture and says, “我来帮你.”",
          "start": 125.808,
          "slot": 2.937,
          "spoken": {
            "zh": 2.937,
            "en": 4.178
          },
          "tracks": {
            "zh": [
              {
