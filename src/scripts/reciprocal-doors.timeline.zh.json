                "lang": "zh",
                "demo": true,
                "offset": 2.265,
                "seconds": 1.19
              }
            ]
          }
        },
        {
          "id": "rd06-03",
          "zh": "Mary 告诉他，英文可以说：“Let me help you.”",
          "en": "Mary tells him, “In English, we can say, ‘Let me help you.’”",
          "start": 166.031,
          "slot": 5.361,
          "spoken": {
            "zh": 5.361,
            "en": 5.09
          },
          "tracks": {
            "zh": [
              {
                "id": "rd06-03-p1",
                "file": "audio/reciprocal-doors/zh/rd06-03-p1.wav",
                "lang": "zh",
                "demo": false,
                "offset": 0,
                "seconds": 3.309
              },
              {
