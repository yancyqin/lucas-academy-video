                "offset": 0,
                "seconds": 1.214
              }
            ]
          }
        },
        {
          "id": "rd06-05",
          "zh": "Mary 试着说中文，Jacob 试着说英文。",
          "en": "Mary tries the Chinese, and Jacob tries the English.",
          "start": 173.606,
          "slot": 4.066,
          "spoken": {
            "zh": 4.066,
            "en": 3.907
          },
          "tracks": {
            "zh": [
              {
                "id": "rd06-05",
                "file": "audio/reciprocal-doors/zh/rd06-05.wav",
                "lang": "zh",
                "demo": false,
                "offset": 0,
                "seconds": 4.066
              }
            ]
          }
        },
        {
          "id": "rd06-06",
          "zh": "说不顺，可以听一听，再试一次。",
          "en": "If a phrase is difficult, they can listen and try again.",
          "start": 178.122,
          "slot": 5.105,
          "spoken": {
            "zh": 5.105,
            "en": 4.848
          },
          "tracks": {
            "zh": [
              {
                "id": "rd06-06",
                "file": "audio/reciprocal-doors/zh/rd06-06.wav",
