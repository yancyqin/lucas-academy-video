                "demo": false,
                "offset": 0,
                "seconds": 5.88
              }
            ]
          }
        },
        {
          "id": "rd06-08",
          "zh": "老师在旁边，帮他们确认意思。",
          "en": "Their teacher helps them check the meaning.",
          "start": 190.157,
          "slot": 4.08,
          "spoken": {
            "zh": 4.08,
            "en": 2.1
          },
          "tracks": {
            "zh": [
              {
                "id": "rd06-08",
