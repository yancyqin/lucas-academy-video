                "offset": 2.982,
                "seconds": 1.502
              }
            ]
          }
        },
        {
          "id": "rd06-04",
          "zh": "然后交换。",
          "en": "Then they switch.",
          "start": 133.998,
          "slot": 0.941,
          "spoken": {
            "zh": 0.941,
