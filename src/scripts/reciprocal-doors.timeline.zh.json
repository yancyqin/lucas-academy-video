                "offset": 0,
                "seconds": 0.941
              }
            ]
          }
        },
        {
          "id": "rd06-05",
          "zh": "Mary 试着说中文，Jacob 试着说英文。",
          "en": "Mary tries the Chinese, and Jacob tries the English.",
          "start": 135.285,
          "slot": 3.122,
          "spoken": {
            "zh": 3.122,
            "en": 3.907
          },
          "tracks": {
            "zh": [
              {
                "id": "rd06-05",
                "file": "audio/reciprocal-doors/zh/rd06-05.wav",
                "lang": "zh",
                "demo": false,
                "offset": 0,
                "seconds": 3.122
              }
            ]
          }
        },
        {
          "id": "rd06-06",
          "zh": "说不顺，可以听一听，再试一次。",
          "en": "If a phrase is difficult, they can listen and try again.",
          "start": 138.753,
          "slot": 3.934,
          "spoken": {
            "zh": 3.934,
            "en": 4.848
          },
          "tracks": {
            "zh": [
              {
                "id": "rd06-06",
                "file": "audio/reciprocal-doors/zh/rd06-06.wav",
                "lang": "zh",
                "demo": false,
                "offset": 0,
                "seconds": 3.934
              }
            ]
          }
        },
        {
          "id": "rd06-07",
          "zh": "遇到不认识的字，就把这个字找出来，一起学。",
          "en": "If a written word is unfamiliar, they find it and learn it together.",
          "start": 143.033,
          "slot": 4.522,
          "spoken": {
            "zh": 4.522,
            "en": 4.979
          },
          "tracks": {
            "zh": [
              {
                "id": "rd06-07",
                "file": "audio/reciprocal-doors/zh/rd06-07.wav",
                "lang": "zh",
                "demo": false,
                "offset": 0,
                "seconds": 4.522
              }
            ]
          }
        },
        {
          "id": "rd06-08",
          "zh": "老师在旁边，帮他们确认意思。",
          "en": "Their teacher helps them check the meaning.",
          "start": 148.017,
          "slot": 3.128,
          "spoken": {
            "zh": 3.128,
            "en": 2.1
          },
          "tracks": {
            "zh": [
