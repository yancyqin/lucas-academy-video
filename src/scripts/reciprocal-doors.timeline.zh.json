                "offset": 3.859,
                "seconds": 1.502
              }
            ]
          }
        },
        {
          "id": "rd06-04",
          "zh": "然后交换。",
          "en": "Then they switch.",
          "start": 171.942,
          "slot": 1.214,
          "spoken": {
            "zh": 1.214,
