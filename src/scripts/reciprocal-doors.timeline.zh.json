                "offset": 1.747,
                "seconds": 1.19
              }
            ]
          }
        },
        {
          "id": "rd06-03",
          "zh": "Mary 告诉他，英文可以说：“Let me help you.”",
          "en": "Mary tells him, “In English, we can say, ‘Let me help you.’”",
          "start": 129.091,
          "slot": 4.484,
          "spoken": {
            "zh": 4.484,
            "en": 5.09
          },
          "tracks": {
            "zh": [
              {
                "id": "rd06-03-p1",
                "file": "audio/reciprocal-doors/zh/rd06-03-p1.wav",
                "lang": "zh",
                "demo": false,
                "offset": 0,
                "seconds": 2.559
              },
              {
                "id": "rd06-03-p2",
