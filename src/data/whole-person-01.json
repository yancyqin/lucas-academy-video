    }
   }
  },
  {
   "id": "wp09-02",
   "section": "wp09",
   "zh": "孩子说：“老师，这一步我还不明白。”",
   "en": "A child says, “Teacher, I don't understand this step yet.”",
   "zhIds": [
    "wp09-02"
   ],
   "enIds": [
    "wp09-02"
   ],
   "start": 250.89,
