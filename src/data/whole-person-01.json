    }
   }
  },
  {
   "id": "wp09-03",
   "section": "wp09",
   "zh": "老师停下来，换一个例子，再问：“现在呢？”",
   "en": "The teacher pauses, tries another example, and asks, “How about now?”",
   "zhIds": [
    "wp09-03"
   ],
   "enIds": [
    "wp09-03"
   ],
